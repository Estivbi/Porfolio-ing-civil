---
import { getDict, type Lang } from '../i18n'
const { lang } = Astro.props as { lang: Lang }
const d = getDict(lang)
---

<section id="experiencia" class="section wrap scroll-mt-14">
  <h2 class="h2">{d.experience.title}</h2>
  <p class="mb-10 text-sm text-niebla">{d.experience.hint}</p>

  <ol class="line">
    {d.experience.items.map((e, i) => (
      <li class="relative pl-10">
        <span class="station absolute left-0 top-[1.55rem]" aria-hidden="true"></span>
        <details name="exp" open={i === 0}>
          <summary class="flex cursor-pointer list-none flex-col gap-1 py-5 md:flex-row md:items-baseline md:justify-between md:gap-8">
            <span>
              <span class="block text-s2 font-semibold tracking-tight">{e.company}</span>
              <span class="block text-niebla">{e.role}</span>
            </span>
            <span class="flex items-center gap-3 font-mono text-xs text-niebla">
              {e.period}
              <span class="chev" aria-hidden="true">+</span>
            </span>
          </summary>
          <div class="body pb-8">
            <ul class="max-w-[66ch] list-disc space-y-3 pl-5 marker:text-ambar">
              {e.points.map(p => <li>{p}</li>)}
            </ul>
            <ul class="mt-5 flex flex-wrap gap-2">
              {e.tags.map(t => <li class="chip">{t}</li>)}
            </ul>
          </div>
        </details>
      </li>
    ))}
  </ol>
</section>

<style>
  .line { position: relative; border-top: 1px solid #262c37; }
  .line::before { content: ''; position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: #262c37; }
  li { border-bottom: 1px solid #262c37; }
  summary::-webkit-details-marker { display: none; }
  details[open] > summary .chev { transform: rotate(45deg); color: #f5b50a; }
  .chev { display: inline-block; transition: transform 320ms cubic-bezier(.2,.7,.2,1); font-size: 1.1rem; }
  li:has(details[open]) .station { background: #f5b50a; border-color: #f5b50a; }
  .body { animation: abre 320ms cubic-bezier(.2,.7,.2,1); }
  @keyframes abre { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
</style>
