---
import { getDict, type Lang } from '../i18n'
const { lang } = Astro.props as { lang: Lang }
const d = getDict(lang)
const STACK = d.marquee.items
---

<section aria-label={d.marquee.label} class="border-y border-riel py-5 overflow-hidden">
  <div class="track flex w-max">
    {[0, 1].map(n => (
      <ul class="flex shrink-0 items-center" aria-hidden={n === 1 ? 'true' : undefined}>
        {STACK.map(t => (
          <li class="flex items-center font-mono text-sm text-niebla">
            <span class="px-6">{t}</span><span class="station" aria-hidden="true" style="width:9px;height:9px;border-width:1.5px"></span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .track { animation: marcha 60s linear infinite; }
  section:hover .track { animation-play-state: paused; }
  @keyframes marcha { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } section { overflow-x: auto; } }
</style>
