---
import { getDict, type Lang } from '../i18n'
const { lang } = Astro.props as { lang: Lang }
const d = getDict(lang)
---

<footer class="border-t border-riel py-10 text-sm text-niebla">
  <div class="wrap flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div class="space-y-1">
      <p>{d.footer.made}</p>
      <p class="font-mono text-xs">© {new Date().getFullYear()} {d.footer.rights}</p>
    </div>
    <ul class="flex flex-wrap items-center gap-6">
      <li><a class="underline underline-offset-4 hover:text-papel" href="https://www.linkedin.com/in/alejandrohern%C3%A1ndezfern%C3%A1ndez" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a class="hover:text-ambar" href="#">{d.footer.top} ↑</a></li>
    </ul>
  </div>
</footer>
