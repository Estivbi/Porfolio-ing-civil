---
import { getDict, type Lang } from '../i18n'
const { lang } = Astro.props as { lang: Lang }
const d = getDict(lang)
---

<section id="ayuda" class="section wrap scroll-mt-14">
  <h2 class="h2">{d.help.title}</h2>
  <ul class="grid border-t border-riel md:grid-cols-2 md:gap-x-16">
    {d.help.items.map(i => (
      <li class="border-b border-riel py-6">
        <p class="text-s2 font-semibold tracking-tight">{i.name}</p>
        <p class="mt-2 max-w-[44ch] text-niebla">{i.text}</p>
      </li>
    ))}
  </ul>
  <a href="#contacto" class="mt-10 inline-block underline underline-offset-4 decoration-ambar decoration-2 transition-colors hover:text-ambar">{d.help.cta}</a>
</section>
